sonic_runtime/**/*.engine
sonic_runtime/**/*.plan
sonic_runtime/**/*.usd
sonic_runtime/**/*.usda
sonic_runtime/**/logs/
sonic_runtime/**/exp_*/
sonic_runtime/**/session_*/


# TensorRT generated engines
*.trt
*.trt.*
sonic_runtime/**/*.trt
