#!/usr/bin/env bash
# Local Thor/PATH defaults. Source this file before running PATH-G1 Python
# servers. The same file also works inside the SONIC deploy Docker where
# ~/PATH-G1 is mounted as /workspace/PATH-G1.

if [[ -z "${PATH_G1_ROOT:-}" ]]; then
  _path_env_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  export PATH_G1_ROOT="$(cd "$_path_env_dir/../.." && pwd)"
fi

export PATH_SONIC_RUNTIME_ROOT="${PATH_SONIC_RUNTIME_ROOT:-$PATH_G1_ROOT/sonic_runtime}"
export PATH_SONIC_DEPLOY_ROOT="${PATH_SONIC_DEPLOY_ROOT:-$PATH_SONIC_RUNTIME_ROOT/gear_sonic_deploy}"

# These remain external because PATH does not modify GMR/cuRoboV2.
export PATH_GROOT_ROOT="${PATH_GROOT_ROOT:-/home/url/GR00T-WholeBodyControl}"
export PATH_GMR_ROOT="${PATH_GMR_ROOT:-/home/url/GMR}"
export PATH_CUROBO_ROOT="${PATH_CUROBO_ROOT:-$PATH_GROOT_ROOT/external_dependencies/curobo_v2}"
export PATH_XROBO_ROOT="${PATH_XROBO_ROOT:-$PATH_GROOT_ROOT/external_dependencies/XRoboToolkit-PC-Service-Pybind_X86_and_ARM64}"

export PYTHONPATH="$PATH_G1_ROOT:$PATH_SONIC_RUNTIME_ROOT:$PATH_CUROBO_ROOT:$PATH_GROOT_ROOT:${PYTHONPATH:-}"
export LD_LIBRARY_PATH="$PATH_XROBO_ROOT/lib/aarch64:${LD_LIBRARY_PATH:-}"

# Jetson Thor (14 cores) CPU partition. Keep the real-time SONIC policy,
# MuJoCo, PATH coordination, and GPU-backed perception feeder threads from
# competing on the same CPU cores. Override any value before sourcing this
# file when a different allocation is needed.
export PATH_SONIC_CPUSET="${PATH_SONIC_CPUSET:-0-3}"
export PATH_SIM_CPUSET="${PATH_SIM_CPUSET:-4-5}"
export PATH_CONTROL_CPUSET="${PATH_CONTROL_CPUSET:-6-7}"
export G1_PERCEPTION_CPUSET="${G1_PERCEPTION_CPUSET:-8-13}"
export G1_PERCEPTION_IO_CPUSET="${G1_PERCEPTION_IO_CPUSET:-8}"
export G1_SAM3_INFERENCE_CPUSET="${G1_SAM3_INFERENCE_CPUSET:-9-13}"
