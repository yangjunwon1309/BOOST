#!/usr/bin/env bash
# Isolated same-host transport defaults for the PATH -> HOMIE -> MuJoCo stack.
export SIM_DDS_INTERFACE="${SIM_DDS_INTERFACE:-lo}"
# PATH's C++ SDK2 bridge and the local HOMIE deploy use Unitree domain 0.
export SIM_DDS_DOMAIN_ID=0
export G1_NETWORK_INTERFACE="$SIM_DDS_INTERFACE"
export CYCLONEDDS_NETWORK_INTERFACE="$SIM_DDS_INTERFACE"

# A separate multicast group/port with TTL 0 keeps simulation commands local and
# prevents collision with a hardware PATH bridge using the usual 239.255.76.67:7667.
export PATH_LCM_URL="${SIM_LCM_URL:-udpm://239.255.76.67:17667?ttl=0}"
export WIFI_LCM_URL="${SIM_WIFI_LCM_URL:-udpm://239.255.77.67:17668?ttl=0}"

export BOOST_HOMIE_ROOT="${BOOST_HOMIE_ROOT:-$BOOST_ROOT/external/homie_g1_29dof}"
export PATH_CONTROL_CPUSET=""
