#!/usr/bin/env bash
# Local Thor/BOOST teleop defaults. Source before starting a PATH-derived server.

if [[ -z "${BOOST_ROOT:-}" && -z "${PATH_G1_ROOT:-}" ]]; then
  _path_env_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  export BOOST_ROOT="$(cd "$_path_env_dir/../.." && pwd)"
fi
export BOOST_ROOT="${BOOST_ROOT:-$PATH_G1_ROOT}"
export PATH_G1_ROOT="${PATH_G1_ROOT:-$BOOST_ROOT}"

## PATH_PYTHON resolves to Pixi's active interpreter when launched with
## `pixi run -e sim ...`. Override only for an explicitly managed environment.
export PATH_PYTHON="${PATH_PYTHON:-python}"

# The normal desktop setup installs Televuer into the Pixi environment. Set
# PATH_TELEVUER_ROOT only when intentionally using a local Televuer source tree.
export PATH_TELEVUER_ROOT="${PATH_TELEVUER_ROOT:-}"
export PATH_TELEVUER_HAND_TRACKING="${PATH_TELEVUER_HAND_TRACKING:-0}"
# These are the defaults; the XR launcher creates a local pair here when absent.
export PATH_TELEVUER_CERT="${PATH_TELEVUER_CERT:-$HOME/.config/xr_teleoperate/cert.pem}"
export PATH_TELEVUER_KEY="${PATH_TELEVUER_KEY:-$HOME/.config/xr_teleoperate/key.pem}"
export PATH_XROBO_ROOT="${PATH_XROBO_ROOT:-$BOOST_ROOT/external/XRoboToolkit-PC-Service-Pybind_X86_and_ARM64}"
export BOOST_EXTERNAL_ROOT="${BOOST_EXTERNAL_ROOT:-$HOME/.local/share/boost/external}"
export BOOST_DREAMWAQ_ROOT="${BOOST_DREAMWAQ_ROOT:-$BOOST_ROOT/external/dreamwaq_g1_29dof}"
export BOOST_TELEIMAGER_ROOT="${BOOST_TELEIMAGER_ROOT:-$BOOST_ROOT/external/teleimager}"
export BOOST_TELEIMAGER_G1_CONFIG="${BOOST_TELEIMAGER_G1_CONFIG:-$BOOST_TELEIMAGER_ROOT/config/hbvcam_4m2214hd_g1.yaml}"
export BOOST_TELEIMAGER_RELAY_CONFIG="${BOOST_TELEIMAGER_RELAY_CONFIG:-$BOOST_ROOT/configs/teleop/teleimager_relay.yaml}"
export BOOST_DREAMWAQ_EXPORT="${BOOST_DREAMWAQ_EXPORT:-$BOOST_DREAMWAQ_ROOT/checkpoints/new3_4_backpack_440000/exported}"
export BOOST_DREAMWAQ_CONFIG="${BOOST_DREAMWAQ_CONFIG:-$BOOST_DREAMWAQ_ROOT/deploy/robot_control/configs/g1_homie.yaml}"
export BOOST_DREAMWAQ_ENV_ROOT="${BOOST_DREAMWAQ_ENV_ROOT:-$BOOST_EXTERNAL_ROOT/venvs/dreamwaq-g1}"
export BOOST_TELEIMAGER_ENV_ROOT="${BOOST_TELEIMAGER_ENV_ROOT:-$BOOST_EXTERNAL_ROOT/venvs/teleimager}"
export BOOST_DREAMWAQ_PYTHON="${BOOST_DREAMWAQ_PYTHON:-$BOOST_DREAMWAQ_ENV_ROOT/bin/python}"
export BOOST_TELEIMAGER_BIN="${BOOST_TELEIMAGER_BIN:-$BOOST_TELEIMAGER_ENV_ROOT/bin/teleimager-server}"
export G1_TELEIMAGER_HOST="${G1_TELEIMAGER_HOST:-192.168.123.164}"
export G1_TELEIMAGER_CAMERA_CPUSET="${G1_TELEIMAGER_CAMERA_CPUSET:-0-2}"

export PYTHONPATH="$PATH_G1_ROOT:$PATH_G1_ROOT/services/pose_service:$BOOST_TELEIMAGER_ROOT/src:$PATH_XROBO_ROOT/build:${PYTHONPATH:-}"
if [[ -d "$PATH_XROBO_ROOT/lib/aarch64" ]]; then
  export LD_LIBRARY_PATH="$PATH_XROBO_ROOT/lib/aarch64:${LD_LIBRARY_PATH:-}"
fi

export G1_NETWORK_INTERFACE="${G1_NETWORK_INTERFACE:-eth0}"
export PATH_LCM_URL="${PATH_LCM_URL:-udpm://239.255.76.67:7667?ttl=1}"
export WIFI_LCM_URL="${WIFI_LCM_URL:-udpm://239.255.77.67:7667?ttl=1}"

# Jetson Thor (14 cores) CPU partition for PATH coordination and GPU-backed
# perception feeder threads. Override any value before sourcing this file when
# a different allocation is needed.
export PATH_CONTROL_CPUSET="${PATH_CONTROL_CPUSET-6-7}"
export G1_PERCEPTION_CPUSET="${G1_PERCEPTION_CPUSET:-8-13}"
export G1_PERCEPTION_IO_CPUSET="${G1_PERCEPTION_IO_CPUSET:-8}"
export G1_SAM3_INFERENCE_CPUSET="${G1_SAM3_INFERENCE_CPUSET:-9-13}"
