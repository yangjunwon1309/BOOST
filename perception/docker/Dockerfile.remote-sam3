ARG BASE_IMAGE=nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04
FROM ${BASE_IMAGE}

# Match SAM3's minimum supported CUDA/PyTorch line.  CUDA and cuDNN stay in
# this image; the host only supplies its NVIDIA driver through the container
# runtime.
ARG PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu126
ARG TORCH_VERSION=2.7.1
ARG TORCHVISION_VERSION=0.22.1
ARG SAM3_REF=46957e47805eaa273f4aa7bbbd25a88bca9108ce

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/cache/huggingface \
    TORCH_HOME=/cache/torch \
    PATH=/opt/venv/bin:${PATH}

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        libgl1 \
        libglib2.0-0 \
        liblcm-dev \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# All Python mutation is isolated inside this image. The laptop host/root Python
# environment is never used or modified by the worker installation.
RUN python3 -m venv /opt/venv \
    && python -m pip install --upgrade pip "setuptools<81" wheel \
    && python -m pip install \
        "torch==${TORCH_VERSION}" \
        "torchvision==${TORCHVISION_VERSION}" \
        --index-url "${PYTORCH_INDEX_URL}"

COPY docker/requirements-remote-yolo11.txt /tmp/requirements-remote-yolo11.txt
COPY docker/requirements-remote-sam3.txt /tmp/requirements-remote-sam3.txt
RUN python -m pip install \
        -r /tmp/requirements-remote-yolo11.txt \
        -r /tmp/requirements-remote-sam3.txt

# Pin the same SAM3 source revision used by the current PATH adapter. This is a
# laptop PyTorch install only; no Thor TensorRT engine or JetPack package enters
# this image.
RUN mkdir -p /opt/sam3 \
    && curl -fsSL "https://github.com/facebookresearch/sam3/archive/${SAM3_REF}.tar.gz" \
        | tar -xz -C /opt/sam3 --strip-components=1 \
    && python -m pip install -e /opt/sam3 \
    && python -c "import einops, sam3; from sam3 import build_sam3_image_model; from sam3.model.sam3_image_processor import Sam3Processor"

RUN mkdir -p /cache/huggingface /cache/torch \
    && chmod -R 0777 /cache

WORKDIR /workspace/perception
COPY . /workspace/perception

CMD ["python", "tools/verify_remote_sam3_environment.py"]
