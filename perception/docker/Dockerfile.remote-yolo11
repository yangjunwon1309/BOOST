ARG BASE_IMAGE=nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04
FROM ${BASE_IMAGE}

ARG PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu121
ARG TORCH_VERSION=2.4.0
ARG TORCHVISION_VERSION=0.19.0
ARG ULTRALYTICS_VERSION=8.4.108

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    YOLO_CONFIG_DIR=/cache/ultralytics \
    TORCH_HOME=/cache/torch

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        libgl1 \
        libglib2.0-0 \
        liblcm-dev \
        python3 \
        python3-pip \
        python3-venv \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/perception

COPY docker/requirements-remote-yolo11.txt /tmp/requirements-remote-yolo11.txt

# Titan XP is Pascal/sm_61.  Keep this path on PyTorch CUDA wheels and do not
# install TensorRT, TensorRT engines, or Thor/JetPack-specific NGC packages.
RUN python3 -m pip install --upgrade pip "setuptools<81" wheel \
    && python3 -m pip install \
        "torch==${TORCH_VERSION}" \
        "torchvision==${TORCHVISION_VERSION}" \
        --index-url "${PYTORCH_INDEX_URL}" \
    && python3 -m pip install -r /tmp/requirements-remote-yolo11.txt \
    && python3 -m pip install --no-deps "ultralytics==${ULTRALYTICS_VERSION}"

RUN mkdir -p /cache/torch /cache/ultralytics \
    && chmod -R 0777 /cache

COPY . /workspace/perception

CMD ["python3", "tools/verify_remote_yolo11_environment.py"]
