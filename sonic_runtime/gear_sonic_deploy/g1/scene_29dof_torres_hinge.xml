<mujoco model="g1_29dof_torres_hinge_scene">
  <!--
    G1 + Torres native MuJoCo articulated-door scene.

    This intentionally does not reference DAE files because the current MuJoCo
    runtime reports "no decoder found" for .dae.  The car body and door use
    native MuJoCo geoms.  The driver door is a real hinge joint named:
      torres_driver_door_hinge
    It is initialized open from G1TorresHingeEnv.reset().
  -->
  <include file="g1_29dof_with_hand.xml"/>

  <statistic center="0.30 -0.25 0.65" extent="3.2"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="torres_body_mat" rgba="0.22 0.25 0.28 1"/>
    <material name="torres_glass_mat" rgba="0.12 0.22 0.32 0.45"/>
    <material name="torres_door_mat" rgba="0.18 0.22 0.25 0.90"/>
    <material name="seat_mat" rgba="0.05 0.05 0.05 1"/>
    <material name="target_green" rgba="0.1 0.8 0.2 0.45"/>
    <material name="warning_orange" rgba="1.0 0.55 0.1 0.55"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" friction="0.8 0.02 0.01"/>

    <!-- Approximate Torres body in world coordinates. Driver door is on negative-y side. -->
    <body name="torres_articulated_proxy" pos="0.85 0.00 0.02">
      <!-- Main body: visual and collision are separated so future mesh replacement is easy. -->
      <geom name="torres_chassis_collision" type="box" pos="0.00 0.00 0.28" size="0.98 0.50 0.18" material="torres_body_mat" contype="1" conaffinity="1"/>
      <geom name="torres_body_visual" type="box" pos="0.04 0.00 0.63" size="0.86 0.46 0.33" material="torres_body_mat" contype="0" conaffinity="0"/>
      <geom name="torres_roof_visual" type="box" pos="0.10 0.00 1.03" size="0.64 0.40 0.04" material="torres_glass_mat" contype="0" conaffinity="0"/>
      <geom name="torres_windshield_visual" type="box" pos="0.55 -0.01 0.84" size="0.035 0.36 0.22" euler="0 -0.42 0" material="torres_glass_mat" contype="0" conaffinity="0"/>
      <geom name="front_dash_collision" type="box" pos="0.72 -0.03 0.66" size="0.12 0.39 0.18" material="torres_body_mat" contype="1" conaffinity="1"/>
      <geom name="center_tunnel_collision" type="box" pos="0.12 0.00 0.43" size="0.52 0.055 0.11" material="torres_body_mat" contype="1" conaffinity="1"/>

      <!-- Doorway boundaries. -->
      <geom name="torres_door_sill" type="box" pos="0.20 -0.50 0.22" size="0.56 0.045 0.055" material="warning_orange" contype="1" conaffinity="1"/>
      <geom name="torres_rear_pillar" type="box" pos="-0.42 -0.50 0.67" size="0.045 0.045 0.42" material="torres_body_mat" contype="1" conaffinity="1"/>
      <geom name="torres_front_pillar" type="box" pos="0.58 -0.50 0.72" size="0.045 0.045 0.50" material="torres_body_mat" contype="1" conaffinity="1"/>

      <!-- Real hinge door. qpos is set to open angle by G1TorresHingeEnv.reset(). -->
      <body name="torres_driver_door_body" pos="0.58 -0.52 0.58">
        <joint name="torres_driver_door_hinge" type="hinge" axis="0 0 1" range="0 1.35" limited="true" damping="15" frictionloss="3"/>
        <!-- Door panel extends outward from the hinge along local negative-y. -->
        <geom name="torres_driver_door_panel" type="box" pos="0.00 -0.38 0.02" size="0.035 0.44 0.34" material="torres_door_mat" contype="1" conaffinity="1" mass="8"/>
        <geom name="torres_driver_door_window" type="box" pos="0.00 -0.39 0.31" size="0.025 0.34 0.13" material="torres_glass_mat" contype="0" conaffinity="0"/>
        <geom name="torres_driver_door_handle" type="capsule" fromto="-0.055 -0.56 0.14 -0.055 -0.34 0.14" size="0.015" material="warning_orange" contype="0" conaffinity="0"/>
      </body>

      <!-- Driver seat and target sites. -->
      <geom name="driver_seat_cushion" type="box" pos="0.02 -0.28 0.48" size="0.30 0.25 0.055" material="seat_mat" contype="1" conaffinity="1" friction="1.0 0.02 0.01"/>
      <geom name="driver_seat_back" type="box" pos="-0.26 -0.28 0.75" size="0.055 0.25 0.30" euler="0 -0.22 0" material="seat_mat" contype="1" conaffinity="1"/>
      <site name="driver_doorway_target" type="sphere" pos="0.18 -0.66 0.42" size="0.055" rgba="1.0 0.55 0.1 0.6"/>
      <site name="driver_seat_target" type="sphere" pos="0.02 -0.28 0.58" size="0.065" rgba="0.1 0.8 0.2 0.6"/>
    </body>

    <site name="com_marker" pos="0.1 0 0" size="0.05" rgba="1 0 0 1" type="sphere"/>
  </worldbody>

  <default>
    <geom friction="0.7 0.02 0.01"/>
  </default>
</mujoco>
