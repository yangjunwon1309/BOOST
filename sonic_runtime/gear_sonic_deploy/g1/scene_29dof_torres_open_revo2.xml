<mujoco model="g1_29dof_torres_open_scene">
  <!--
    PICO teleop MuJoCo scene: G1 + Torres driver-side open-door scene.

    This scene uses the Torres mesh asset for visual context when installed at:
      gear_sonic_deploy/.../g1/meshes/torres_mini_proxy/texture_dae/*.dae

    Collision remains lightweight proxy geometry for stable teleop testing.
    The actual open/close articulated door dynamics are not simulated here;
    this is for spatial teleop practice around an already-open driver's door.
  -->
  <include file="g1_29dof_with_revo2.xml"/>

  <statistic center="0.35 -0.25 0.65" extent="3.2"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="torres_body_mat" rgba="0.22 0.25 0.28 1"/>
    <material name="torres_door_mat" rgba="0.18 0.22 0.25 0.90"/>
    <material name="seat_mat" rgba="0.05 0.05 0.05 1"/>
    <material name="target_green" rgba="0.1 0.8 0.2 0.45"/>
    <material name="warning_orange" rgba="1.0 0.55 0.1 0.55"/>

    <!-- These files are copied by scripts/install_torres_asset_for_mujoco.sh. -->
      <mesh name="torres_car_board" file="torres_mini_proxy/texture_obj/car_board.obj"/>
    <mesh name="torres_car_door" file="torres_mini_proxy/texture_obj/car_door.obj"/>
    <mesh name="torres_handle_lock" file="torres_mini_proxy/texture_obj/handle_lock.obj"/>
    <mesh name="torres_handle" file="torres_mini_proxy/texture_obj/handle.obj"/>
</asset>

  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" friction="0.8 0.02 0.01"/>

    <!-- Torres coordinate targets from emergence_ggyu_sub/core/car_interaction_scene_config.py:
         car_base_pos=(0.9,0,ground_lift), handle_target_pos≈(0.78,-0.07,0.92),
         robot_start_pos≈(-1.20,-0.07,0.78).  Mesh orientation follows the
         prepared Torres URDF fixed joint Rz(-pi/2). -->
    <body name="torres_open_scene" pos="0.9 0 0.02" euler="0 0 -1.570796326794897">
      <!-- Visual Torres body. Visual-only to avoid unstable triangle mesh contacts. -->
    <geom name="torres_body_visual" type="mesh" mesh="torres_car_board" material="torres_body_mat" contype="0" conaffinity="0"/>

      <!-- Stable proxy collisions approximating chassis and cabin. -->
      <geom name="torres_chassis_collision" type="box" pos="0.00 0.00 0.28" size="0.95 0.48 0.18" contype="1" conaffinity="1" group="3" rgba="0 0 0 0"/>
      <geom name="torres_dash_collision" type="box" pos="0.72 -0.03 0.66" size="0.12 0.39 0.18" contype="1" conaffinity="1" group="3" rgba="0 0 0 0"/>
      <geom name="torres_center_tunnel_collision" type="box" pos="0.12 0.0 0.43" size="0.52 0.055 0.11" contype="1" conaffinity="1" group="3" rgba="0 0 0 0"/>

      <!-- Open driver door: visual Torres door mesh plus simple collision panel. -->
      <body name="torres_driver_door_open" pos="-1.0737739406004048 0.5477275064157311 0" euler="0 0 -1.05">
    <geom name="torres_door_visual" type="mesh" mesh="torres_car_door" pos="1.0737739406004048 -0.5477275064157311 0" material="torres_door_mat" contype="0" conaffinity="0"/>
        <geom name="torres_door_panel_collision" type="box" pos="1.02 -0.82 0.55" size="0.035 0.44 0.34" contype="1" conaffinity="1" group="3" rgba="0 0 0 0"/>
    <geom name="torres_handle_lock_visual" type="mesh" mesh="torres_handle_lock" pos="1.0637739406004048 -0.5477275064157311 0.005" rgba="1.0 0.45 0.05 1.0" contype="0" conaffinity="0"/>
    <geom name="torres_handle_visual" type="mesh" mesh="torres_handle" pos="1.0637739406004048 -0.5477275064157311 0.005" rgba="1.0 0.45 0.05 1.0" contype="0" conaffinity="0"/>
      </body>

      <!-- Open doorway and driver seat proxies. -->
      <geom name="torres_door_sill" type="box" pos="0.20 -0.50 0.22" size="0.56 0.045 0.055" contype="1" conaffinity="1" group="3" rgba="0 0 0 0"/>
      <geom name="torres_rear_pillar" type="box" pos="-0.42 -0.50 0.67" size="0.045 0.045 0.42" contype="1" conaffinity="1" group="3" rgba="0 0 0 0"/>
      <geom name="torres_front_pillar" type="box" pos="0.58 -0.50 0.72" size="0.045 0.045 0.50" contype="1" conaffinity="1" group="3" rgba="0 0 0 0"/>
      <geom name="driver_seat_cushion" type="box" pos="0.02 -0.28 0.48" size="0.30 0.25 0.055" material="seat_mat" contype="1" conaffinity="1" friction="1.0 0.02 0.01"/>
      <geom name="driver_seat_back" type="box" pos="-0.26 -0.28 0.75" size="0.055 0.25 0.30" euler="0 -0.22 0" material="seat_mat" contype="1" conaffinity="1"/>

      <site name="driver_doorway_target" type="sphere" pos="0.18 -0.66 0.42" size="0.055" rgba="1.0 0.55 0.1 0.6"/>
      <site name="driver_seat_target" type="sphere" pos="0.02 -0.28 0.58" size="0.065" rgba="0.1 0.8 0.2 0.6"/>
    </body>

    <site name="com_marker" pos="0.1 0 0" size="0.05" rgba="1 0 0 1" type="sphere"/>
  </worldbody>

  <default>
    <geom friction="0.7 0.02 0.01"/>
  </default>
</mujoco>
